generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CLIENT
  THERAPIST
  ADMIN
  CLINICAL_DIRECTOR
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum TherapistStatus {
  PENDING_VERIFICATION
  VERIFIED
  ACTIVE
  REJECTED
  SUSPENDED
}

enum RiskLevel {
  NONE
  LOW
  ELEVATED
  CRITICAL
}

enum BookingStatus {
  PENDING_PAYMENT
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum PaymentProvider {
  MPESA
  CARD
  GIFT
}

enum PaymentStatus {
  INITIATED
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum SessionChannel {
  VIDEO
  AUDIO
  CHAT
}

enum SessionStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  TECH_FAILURE
}

enum IncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ComplaintStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  CLOSED
}

model User {
  id            String     @id @default(uuid())
  email         String?    @unique
  phone         String     @unique
  passwordHash  String
  role          UserRole
  status        UserStatus @default(ACTIVE)
  phoneVerified Boolean    @default(false)
  /// Session reminders and new-message alerts by SMS. On by default; clients on a shared
  /// phone may want them off, so it's a single, easy-to-find switch.
  smsNotificationsEnabled Boolean @default(true)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  clientProfile    ClientProfile?
  therapistProfile TherapistProfile?
  refreshTokens    RefreshToken[]
  otpCodes         OtpCode[]
  auditLogs        AuditLogEntry[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

model OtpCode {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  purpose   String   @default("PHONE_VERIFICATION")
  expiresAt DateTime
  consumedAt DateTime?
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([userId, purpose])
  @@map("otp_codes")
}

model ClientProfile {
  userId            String    @id
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName          String
  preferredLanguage String    @default("en")
  dateOfBirth       DateTime?
  isMinor           Boolean   @default(false)
  guardianContact   String?

  @@map("client_profiles")
}

model TherapistProfile {
  userId       String          @id
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName     String
  status       TherapistStatus @default(PENDING_VERIFICATION)
  bio          String?
  specialties  String[]
  languages    String[]
  approach     String?
  feeKES       Int
  photoUrl           String?
  yearsExperience    Int?
  /// Lower fee for clients approved for fee assistance; null = not offered.
  reducedFeeKES      Int?
  /// Professional board registration/licence number, shown publicly so clients can check it.
  registrationNumber String?
  verifiedAt   DateTime?
  verifiedById String?
  createdAt    DateTime        @default(now())

  credentials TherapistCredential[]
  slots       AvailabilitySlot[]

  @@map("therapist_profiles")
}

model TherapistCredential {
  id           String            @id @default(uuid())
  therapistId  String
  therapist    TherapistProfile  @relation(fields: [therapistId], references: [userId], onDelete: Cascade)
  type         String
  documentUrl  String
  verified     Boolean           @default(false)
  verifiedById String?
  verifiedAt   DateTime?
  createdAt    DateTime          @default(now())

  @@index([therapistId])
  @@map("therapist_credentials")
}

model AvailabilitySlot {
  id          String            @id @default(uuid())
  therapistId String
  therapist   TherapistProfile  @relation(fields: [therapistId], references: [userId], onDelete: Cascade)
  startTime   DateTime
  endTime     DateTime
  isBooked    Boolean           @default(false)
  createdAt   DateTime          @default(now())

  booking Booking?

  @@unique([therapistId, startTime])
  @@map("availability_slots")
}

model IntakeAssessment {
  id                            String    @id @default(uuid())
  clientId                      String
  presentingConcern             String
  concernTags                   String[]
  preferredApproach             String?
  preferredCommunicationMethod  String?
  previousCounsellingExperience Boolean?
  availability                  Json
  safetyAnswers                 Json
  riskLevel                     RiskLevel
  blockedBooking                Boolean   @default(false)
  createdAt                     DateTime  @default(now())

  matchResult MatchResult?

  @@index([clientId])
  @@map("intake_assessments")
}

model MatchResult {
  id               String           @id @default(uuid())
  intakeId         String           @unique
  intake           IntakeAssessment @relation(fields: [intakeId], references: [id], onDelete: Cascade)
  therapistIds     String[]
  criteriaSnapshot Json
  createdAt        DateTime         @default(now())

  @@map("match_results")
}

model Booking {
  id          String        @id @default(uuid())
  clientId    String
  therapistId String
  slotId      String        @unique
  slot        AvailabilitySlot @relation(fields: [slotId], references: [id])
  status      BookingStatus @default(PENDING_PAYMENT)
  createdAt   DateTime      @default(now())
  expiresAt   DateTime
  /// Set when the corresponding SMS reminder is claimed for sending — see
  /// modules/notifications/reminders.service.ts. Null means "not sent yet".
  reminderDaySentAt  DateTime?
  reminderHourSentAt DateTime?
  /// The fee agreed when the booking was made, so a later change to the therapist's fee
  /// never changes what an already-booked client pays. Null on bookings made before this
  /// column existed — those fall back to the therapist's current fee.
  feeKES      Int?
  reducedFee  Boolean       @default(false)

  payment  Payment?
  session  Session?
  consent  ConsentRecord?
  feedback Feedback?

  @@index([clientId])
  @@index([therapistId])
  @@map("bookings")
}

model ConsentVersion {
  id          String   @id @default(uuid())
  version     Int      @unique
  content     String
  effectiveAt DateTime

  @@map("consent_versions")
}

model ConsentRecord {
  id               String   @id @default(uuid())
  bookingId        String   @unique
  booking          Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  clientId         String
  consentVersionId String
  acceptedAt       DateTime @default(now())

  @@map("consent_records")
}

model Payment {
  id                String          @id @default(uuid())
  bookingId         String          @unique
  booking           Booking         @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  provider          PaymentProvider
  amountKES         Int
  status            PaymentStatus   @default(INITIATED)
  providerReference String?         @unique
  idempotencyKey    String          @unique
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@map("payments")
}

model Session {
  id        String         @id @default(uuid())
  bookingId String         @unique
  booking   Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  channel   SessionChannel
  status    SessionStatus  @default(SCHEDULED)
  roomToken String?
  startedAt DateTime?
  endedAt   DateTime?

  incidents SafeguardingIncident[]

  @@map("sessions")
}

model SafeguardingIncident {
  id                   String           @id @default(uuid())
  clientId             String
  therapistId          String
  sessionId            String?
  session              Session?         @relation(fields: [sessionId], references: [id])
  triggeredBy          String
  severity             IncidentSeverity
  actionsTaken         Json
  supervisorNotifiedAt DateTime?
  outcome              String?
  createdAt            DateTime         @default(now())

  @@index([clientId])
  @@map("safeguarding_incidents")
}

model Feedback {
  id        String   @id @default(uuid())
  bookingId String   @unique
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  clientId  String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  @@map("feedback")
}

model Complaint {
  id          String          @id @default(uuid())
  userId      String
  description String
  status      ComplaintStatus @default(OPEN)
  resolution  String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@map("complaints")
}

model AuditLogEntry {
  id           String   @id @default(uuid())
  actorId      String?
  actor        User?    @relation(fields: [actorId], references: [id])
  action       String
  resourceType String
  resourceId   String
  metadata     Json?
  createdAt    DateTime @default(now())

  @@index([actorId])
  @@index([resourceType, resourceId])
  @@map("audit_log_entries")
}

model Message {
  id          String    @id @default(uuid())
  clientId    String
  therapistId String
  senderId    String
  body        String
  /// Set by the keyword screen in lib/riskLanguage.ts on client messages, so the sender
  /// is shown emergency numbers and the therapist sees the message highlighted.
  riskFlagged Boolean   @default(false)
  /// Set when sent during a live text-chat session; the message still belongs to the
  /// client–therapist conversation, so the transcript appears there too.
  sessionId   String?
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([clientId, therapistId, createdAt])
  @@index([therapistId, clientId, createdAt])
  @@index([sessionId, createdAt])
  @@map("messages")
}

/// A client asking for new matches instead of their current therapist (FR-CLI-11). The
/// reason is for platform quality review only — it is never shown to the therapist.
model TherapistSwitch {
  id                    String   @id @default(uuid())
  clientId              String
  fromTherapistId       String
  reason                String
  comment               String?
  suggestedTherapistIds String[]
  createdAt             DateTime @default(now())

  @@index([clientId])
  @@index([fromTherapistId])
  @@map("therapist_switches")
}

enum GoalStatus {
  ACTIVE
  ACHIEVED
  ARCHIVED
}

enum WorksheetStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

/// Client toolkit items (journal, goals, worksheets) are private to the client unless
/// they share an individual item with one therapist from their care team.
model JournalEntry {
  id                    String   @id @default(uuid())
  clientId              String
  title                 String?
  body                  String
  mood                  Int?
  sharedWithTherapistId String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([clientId, createdAt])
  @@index([sharedWithTherapistId])
  @@map("journal_entries")
}

model Goal {
  id                    String     @id @default(uuid())
  clientId              String
  title                 String
  description           String?
  status                GoalStatus @default(ACTIVE)
  progress              Int        @default(0)
  sharedWithTherapistId String?
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  @@index([clientId])
  @@index([sharedWithTherapistId])
  @@map("goals")
}

/// One client's answers to one worksheet (definitions live in packages/shared/src/worksheets.ts).
model WorksheetResponse {
  id                    String          @id @default(uuid())
  clientId              String
  worksheetSlug         String
  assignedById          String?
  assignmentNote        String?
  status                WorksheetStatus @default(NOT_STARTED)
  answers               Json            @default("{}")
  sharedWithTherapistId String?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  completedAt           DateTime?

  @@index([clientId])
  @@index([sharedWithTherapistId])
  @@map("worksheet_responses")
}

enum FeeAssistanceStatus {
  PENDING
  APPROVED
  DECLINED
}

/// A client's application for reduced fees (PRD §16 cross-subsidy model), reviewed by an admin.
model FeeAssistanceApplication {
  id            String              @id @default(uuid())
  clientId      String
  incomeBand    String
  householdSize Int?
  reason        String
  status        FeeAssistanceStatus @default(PENDING)
  reviewedById  String?
  reviewedAt    DateTime?
  reviewNote    String?
  /// Set on approval: reduced fees apply to bookings made before this time.
  expiresAt     DateTime?
  createdAt     DateTime            @default(now())

  @@index([clientId, createdAt])
  @@index([status])
  @@map("fee_assistance_applications")
}

enum GiftVoucherStatus {
  PENDING_PAYMENT
  ACTIVE
  USED_UP
  PAYMENT_FAILED
}

/// Prepaid session credit bought for someone else. Spent session by session via
/// GiftRedemption; expiry is checked at redemption rather than stored as a status.
model GiftVoucher {
  id                String            @id @default(uuid())
  /// Stored without the display dash, uppercase (see modules/gifts/giftCode.ts).
  code              String            @unique
  purchaserId       String
  amountKES         Int
  balanceKES        Int               @default(0)
  recipientName     String?
  recipientPhone    String?
  message           String?
  status            GiftVoucherStatus @default(PENDING_PAYMENT)
  idempotencyKey    String            @unique
  providerReference String?           @unique
  expiresAt         DateTime
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  redemptions GiftRedemption[]

  @@index([purchaserId])
  @@map("gift_vouchers")
}

model GiftRedemption {
  id        String      @id @default(uuid())
  voucherId String
  voucher   GiftVoucher @relation(fields: [voucherId], references: [id])
  bookingId String      @unique
  clientId  String
  amountKES Int
  createdAt DateTime    @default(now())

  @@index([voucherId])
  @@map("gift_redemptions")
}
