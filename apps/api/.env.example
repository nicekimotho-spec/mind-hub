NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://mindhub:mindhub@localhost:5545/mindhub_dev
WEB_ORIGIN=http://localhost:5173
JWT_ACCESS_SECRET=change-me-to-a-random-32-byte-hex-string
BCRYPT_SALT_ROUNDS=12
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
REDIS_URL=redis://localhost:6389
BOOKING_HOLD_MINUTES=15
CANCELLATION_WINDOW_HOURS=24

# M-Pesa Daraja — leave the three below unset to run in stub mode (see lib/mpesa.ts)
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
MPESA_CALLBACK_URL=http://localhost:4000/api/v1/payments/mpesa/callback
MPESA_CALLBACK_ALLOWED_IPS=

JOIN_WINDOW_MINUTES_BEFORE=10

# Africa's Talking SMS — leave AT_USERNAME/AT_API_KEY unset to run in stub mode (see lib/sms.ts)
AT_ENV=sandbox
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=
DISPLAY_TIMEZONE=Africa/Nairobi
